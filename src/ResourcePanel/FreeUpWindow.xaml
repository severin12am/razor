<Window x:Class="ResourcePanel.FreeUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free up this PC" WindowStartupLocation="CenterOwner"
        Width="420" SizeToContent="Height" MaxHeight="680"
        ResizeMode="NoResize" WindowStyle="None"
        Background="#1C1F27" Foreground="#E8EAF0"
        FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False" Topmost="True">
  <Border BorderBrush="#2C313C" BorderThickness="1" Padding="16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <CheckBox x:Name="PowerBox" Content="Switch to the High performance power plan" Margin="0,4"/>
        <CheckBox x:Name="GameBox" Content="Turn on Windows Game Mode" Margin="0,4"/>
        <TextBlock x:Name="AlreadyText" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <UniformGrid Columns="2" Margin="0,12,0,0">
          <Button Content="Cancel" Margin="0,0,6,0" Height="34" Click="Cancel_Click" Background="#2A2F3A" Foreground="#E8EAF0" BorderThickness="0"/>
          <Button x:Name="GoButton" Content="Pause these" Margin="6,0,0,0" Height="34" Click="Go_Click" Background="#6FDBA2" Foreground="#102117" BorderThickness="0" FontWeight="SemiBold"/>
        </UniformGrid>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Free up this PC" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="#C5CAD3" Margin="0,6,0,8"
                   Text="This pauses background helpers. It does not close them, and it does not close the app you are using. Your browser, chat, launcher, and game stay open unless you check them yourself. Resume all puts the paused ones back."/>
        <TextBlock Text="Will pause" FontWeight="SemiBold" Foreground="#6FDBA2"/>
        <TextBlock x:Name="EmptyPause" Text="Nothing extra is running in the background." Foreground="#9AA3B2" Margin="0,2,0,6" Visibility="Collapsed"/>
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="PauseItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="22,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="Stays open" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Text="Apps you may be using. Unchecked on purpose." Foreground="#9AA3B2" Margin="0,2,0,4"/>
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="KeepItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="22,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
