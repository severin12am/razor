<Window x:Class="ResourcePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ResourcePanel"
        xmlns:core="clr-namespace:ResourcePanel;assembly=ResourcePanel.Core"
        Title="{x:Static core:AppInfo.ProductName}"
        Width="380" Height="760"
        MinWidth="320" MinHeight="520" MaxWidth="560"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="True" Topmost="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <CollectionViewSource x:Key="ProcessView" Source="{Binding Processes}"/>
    <DataTemplate x:Key="FindingTemplate" DataType="local:FindingRow">
      <Grid Margin="0,2,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,8,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DebloatTemplate" DataType="local:DebloatRow">
      <Grid Margin="0,2,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Top" Margin="0,2,8,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Warn}" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Height="40" Background="#101218">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Grid.Column="0" Content="Top processes" Height="28" Padding="8,0" Margin="8,0,0,0"
              Style="{StaticResource PrimaryButton}" Click="Back_Click" Visibility="{Binding ShowBack, Converter={StaticResource BoolVis}}"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      <TextBlock Grid.Column="1" Text="{x:Static core:AppInfo.ProductName}" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="12,0"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
        <Button x:Name="CompactButton" Content="Mini" Style="{StaticResource IconButton}" Width="40" Click="Compact_Click" ToolTip="Switch between the full panel and a smaller one" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="PinButton" Content="Pin" Style="{StaticResource IconButton}" Width="36" Click="Pin_Click" ToolTip="Lock this position" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="TopmostButton" Content="Top" Style="{StaticResource IconButton}" Width="36" Click="Topmost_Click" ToolTip="Keep above other windows" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Content="Dock" Style="{StaticResource IconButton}" Width="40" Click="Dock_Click" ToolTip="Float, or sit on the left or right edge" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Hide to the notification area" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="MenuButton" Content="···" Style="{StaticResource IconButton}" Click="Menu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Restart as admin" Click="RestartAdmin_Click"/>
              <MenuItem x:Name="StartWithWindowsItem" Header="Start with Windows" IsCheckable="True" Click="StartWithWindows_Click"/>
              <MenuItem Header="Speed up" Click="Speed_Click"/>
              <MenuItem Header="Usually not needed" Click="OpenOptional_Click"/>
              <MenuItem Header="Put a shortcut on the desktop" Click="Shortcut_Click"/>
              <MenuItem Header="Activity log" Click="OpenLog_Click"/>
              <Separator/>
              <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="10,8,10,0">
      <Border Background="{StaticResource Brush.Card}" CornerRadius="10" Padding="10,8" ClipToBounds="True" Visibility="{Binding ShowFull, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="CPU" Foreground="#C5CAD6" FontSize="11"/>
              <TextBlock Text="{Binding CpuText}" FontSize="18" FontWeight="SemiBold"/>
              <local:MeterBar Height="6" Margin="0,4,0,0" Value="{Binding CpuValue}"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <TextBlock Text="Memory" Foreground="#C5CAD6" FontSize="11"/>
              <TextBlock Text="{Binding RamText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <local:MeterBar Height="6" Margin="0,4,0,0" Value="{Binding RamValue}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="GPU" Foreground="#C5CAD6" FontSize="11"/>
              <TextBlock Text="{Binding GpuText}" FontSize="18" FontWeight="SemiBold"/>
              <local:MeterBar Height="6" Margin="0,4,0,0" Value="{Binding GpuValue}"/>
            </StackPanel>
          </UniformGrid>
          <local:Sparkline Height="26" Margin="0,8,0,0" Values="{Binding MachineCpuSeries}" Stroke="{StaticResource Brush.Accent}"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Disk" Foreground="#C5CAD6" FontSize="11"/>
              <TextBlock Text="{Binding DiskText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="Network" Foreground="#C5CAD6" FontSize="11"/>
              <TextBlock Text="{Binding NetText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <local:Sparkline Height="18" Margin="0,4,0,0" Values="{Binding MachineNetSeries}" Stroke="{StaticResource Brush.Warn}"/>
            </StackPanel>
          </Grid>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
            <Run Text="Battery  " Foreground="#C5CAD6"/>
            <Run Text="{Binding BatteryText, Mode=OneWay}" FontWeight="SemiBold"/>
          </TextBlock>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Brush.Card}" CornerRadius="10" Padding="8,6" Visibility="{Binding IsCompact, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,6,0">
              <TextBlock FontSize="11"><Run Text="CPU "/><Run Text="{Binding CpuText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
              <local:MeterBar Height="6" Margin="0,3,0,0" Value="{Binding CpuValue}"/>
            </StackPanel>
            <StackPanel Margin="3,0">
              <TextBlock FontSize="11"><Run Text="RAM "/><Run Text="{Binding RamText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
              <local:MeterBar Height="6" Margin="0,3,0,0" Value="{Binding RamValue}"/>
            </StackPanel>
            <StackPanel Margin="6,0,0,0">
              <TextBlock FontSize="11"><Run Text="GPU "/><Run Text="{Binding GpuText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
              <local:MeterBar Height="6" Margin="0,3,0,0" Value="{Binding GpuValue}"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap">
            <Run Text="Disk "/><Run Text="{Binding DiskText, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/>
            <Run Text="   Net "/><Run Text="{Binding NetText, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/>
          </TextBlock>
          <TextBlock FontSize="11" Foreground="{StaticResource Brush.Muted}"><Run Text="Battery "/><Run Text="{Binding BatteryText, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/></TextBlock>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Margin="10,8,10,0">
      <StackPanel Visibility="{Binding ShowFull, Converter={StaticResource BoolVis}}">
        <UniformGrid Columns="2">
          <Button Content="Check PC" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Check_Click"/>
          <Button Content="Free up now" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="FreeUp_Click" ToolTip="Pauses background helpers. Apps you are using stay open."/>
        </UniformGrid>
        <UniformGrid Columns="3" Margin="0,6,0,0">
          <Button Content="Top processes" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="Back_Click"/>
          <Button Content="Speed up" Style="{StaticResource SecondaryButton}" Margin="4,0" Click="Speed_Click"/>
          <Button Content="Not needed" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="OpenOptional_Click"/>
        </UniformGrid>
      </StackPanel>
      <UniformGrid Columns="2" Visibility="{Binding IsCompact, Converter={StaticResource BoolVis}}">
        <Button Content="Free up" Style="{StaticResource PrimaryButton}" Height="30" Margin="0,0,4,0" Click="FreeUp_Click"/>
        <Button Content="Apps" Style="{StaticResource SecondaryButton}" Height="30" Margin="4,0,0,0" Click="Back_Click"/>
      </UniformGrid>
      <Border Background="#243044" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Visibility="{Binding ShowCoach, Converter={StaticResource BoolVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButton}" Foreground="#E8EAF0" Click="DismissCoach_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <TextBlock TextWrapping="Wrap" Foreground="#E8EAF0" FontSize="13"
                     Text="Free up pauses background apps only. It does not close the app you are using."/>
          <Button Content="Put a shortcut on the desktop" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,8,28,0" Click="Shortcut_Click"/>
        </DockPanel>
      </Border>
      <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowResume, Converter={StaticResource BoolVis}}">
        <Button DockPanel.Dock="Right" Content="Resume all" Style="{StaticResource SecondaryButton}" Width="110" Height="30" Click="Resume_Click"/>
        <TextBlock Text="{Binding ResumeText}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}"/>
      </DockPanel>
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>

    <Grid Grid.Row="4" Margin="10,8,10,0">
      <Grid Visibility="{Binding ShowCompactHome, Converter={StaticResource BoolVis}}">
        <ListBox ItemsSource="{Binding CompactRows}" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="local:ProcessRow">
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <local:MeterBar Grid.Column="1" Height="6" Margin="6,0" VerticalAlignment="Center" Value="{Binding BarValue}"/>
                <TextBlock Grid.Column="2" Text="{Binding CpuText}" Foreground="{Binding CpuBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Grid Visibility="{Binding ShowFullHome, Converter={StaticResource BoolVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="96" ItemsSource="{Binding SortNames}" SelectedItem="{Binding Sort, Mode=TwoWay}" SelectionChanged="Sort_Changed"/>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="Search_Changed" Padding="8,5" Background="#1C1F27" Foreground="{StaticResource Brush.Text}" BorderBrush="{StaticResource Brush.Line}" CaretBrush="{StaticResource Brush.Text}"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
          <ToggleButton Content="My apps" Style="{StaticResource Chip}" IsChecked="{Binding UserAppsOnly}" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Hide Windows services and system processes"/>
          <ToggleButton Content="Hide Microsoft" Style="{StaticResource Chip}" IsChecked="{Binding HideMicrosoft}" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Hide processes signed by Microsoft"/>
          <ToggleButton Content="Hide idle" Style="{StaticResource Chip}" IsChecked="{Binding HideIdle}" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Hide apps under 0.1% CPU with almost no disk or network"/>
        </StackPanel>
        <ListBox x:Name="ProcessList" Grid.Row="2"
                 ItemsSource="{Binding Source={StaticResource ProcessView}}"
                 SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="local:ProcessRow">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <Grid Margin="0,4,8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="14"/>
                      <RowDefinition Height="14"/>
                      <RowDefinition Height="14"/>
                      <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CPU" FontSize="10" Foreground="#C5CAD6" VerticalAlignment="Center"/>
                    <local:MeterBar Grid.Column="1" Height="5" Margin="4,0" VerticalAlignment="Center" Value="{Binding BarValue}"/>
                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="10" HorizontalAlignment="Right" Foreground="{Binding CpuBrush}"/>
                    <TextBlock Grid.Row="1" Text="RAM" FontSize="10" Foreground="#C5CAD6" VerticalAlignment="Center"/>
                    <local:MeterBar Grid.Row="1" Grid.Column="1" Height="5" Margin="4,0" VerticalAlignment="Center" Value="{Binding RamBar}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamText}" FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="Disk" FontSize="10" Foreground="#C5CAD6" VerticalAlignment="Center"/>
                    <local:MeterBar Grid.Row="2" Grid.Column="1" Height="5" Margin="4,0" VerticalAlignment="Center" Value="{Binding DiskBar}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DiskLabel}" FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="3" Text="Net" FontSize="10" Foreground="#C5CAD6" VerticalAlignment="Center"/>
                    <local:MeterBar Grid.Row="3" Grid.Column="1" Height="5" Margin="4,0" VerticalAlignment="Center" Value="{Binding NetBar}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding NetLabel}" FontSize="10" HorizontalAlignment="Right"/>
                  </Grid>
                  <TextBlock Text="{Binding SubLine}" Foreground="{StaticResource Brush.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Content="{Binding PauseLabel}" Style="{StaticResource QuietButton}" Click="PauseRow_Click" Visibility="{Binding CanControl, Converter={StaticResource BoolVis}}"/>
                  <Button Content="End" Style="{StaticResource QuietButton}" Foreground="{StaticResource Brush.Danger}" Click="EndRow_Click" Visibility="{Binding CanControl, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="3" Background="{StaticResource Brush.Card}" CornerRadius="10" Padding="10" Margin="0,8,0,0" MaxHeight="230"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding SelectedProcess.Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding SelectedProcess.Path}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding CommandLine}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Margin="0,4,0,0"><Run Text="Parent  "/><Run Text="{Binding SelectedProcess.Parent, Mode=OneWay}"/></TextBlock>
              <TextBlock><Run Text="Publisher  "/><Run Text="{Binding SelectedProcess.Publisher, Mode=OneWay}"/></TextBlock>
              <TextBlock Text="{Binding SelectedProcess.Services}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding DetailStartup}" TextWrapping="Wrap"/>
              <TextBlock Text="Connections" Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,2"/>
              <TextBlock Text="{Binding Connections}" TextWrapping="Wrap"/>
              <DockPanel Margin="0,8,0,2">
                <TextBlock Text="CPU" Width="70" Foreground="{StaticResource Brush.Muted}"/>
                <local:Sparkline Height="32" Values="{Binding SelectedCpuSeries}" Stroke="{StaticResource Brush.Accent}"/>
              </DockPanel>
              <DockPanel>
                <TextBlock Text="Network" Width="70" Foreground="{StaticResource Brush.Muted}"/>
                <local:Sparkline Height="32" Values="{Binding SelectedNetSeries}" Stroke="{StaticResource Brush.Warn}"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="End tree" Style="{StaticResource QuietButton}" Click="EndTree_Click"/>
                <Button Content="Service…" Style="{StaticResource QuietButton}" Click="Service_Click"/>
                <Button Content="Startup" Style="{StaticResource QuietButton}" Click="Startup_Click"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <ScrollViewer Visibility="{Binding ShowSpeed, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Button Content="Top processes" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="Back_Click"/>
          <TextBlock Text="Speed up" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Margin="0,6,0,8" Foreground="#C5CAD6"
                     Text="Each step says what it changes. Do this applies only that step. Undo puts it back. Steps with a red warning can turn off security, updates, or other Windows pieces. Nothing runs until you confirm."/>
          <ItemsControl ItemsSource="{Binding SpeedItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:SpeedStepRow">
                <Border Background="#1C1F27" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#6FDBA2" Margin="8,0,0,0"/>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#C5CAD6" Margin="0,4,0,4"/>
                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#F07178" FontWeight="SemiBold" Margin="0,0,0,8"
                               Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>
                    <Button Content="{Binding ActionLabel}" Style="{StaticResource SecondaryButton}" Height="30" HorizontalAlignment="Left" MinWidth="90" Click="SpeedStep_Click"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Visibility="{Binding ShowCheck, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Button Content="Top processes" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="Back_Click"/>
          <TextBlock Text="{Binding CheckSummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock Text="Safe to pause" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding SafeItems}" ItemTemplate="{StaticResource FindingTemplate}"/>
          <TextBlock Text="You decide" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding AskItems}" ItemTemplate="{StaticResource FindingTemplate}"/>
          <TextBlock Text="Starts with Windows" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding StartupItems}" ItemTemplate="{StaticResource FindingTemplate}"/>
          <TextBlock Text="{Binding OptionalSummary}" TextWrapping="Wrap" Margin="0,10,0,6" Foreground="{StaticResource Brush.Muted}"/>
          <Button Content="Pause selected" Style="{StaticResource PrimaryButton}" Margin="0,4,0,4" Click="PauseSelected_Click"/>
          <Button Content="Turn off selected startup items" Style="{StaticResource SecondaryButton}" Margin="0,4" Click="DisableStartup_Click"/>
          <Button Content="Usually not needed" Style="{StaticResource SecondaryButton}" Margin="0,4" Click="OpenOptional_Click"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Visibility="{Binding ShowOptional, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Button Content="Top processes" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="Back_Click"/>
          <TextBlock Text="Usually not needed" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Warn}" Margin="0,6,0,8"
                     Text="These are extras that usually are not needed: Xbox, widgets, trials, and similar apps. Removing one can break a Store app that depended on it. A restore point is created first. Free up now does not remove anything here. Defender and Windows Update stay in the closed section at the bottom."/>
          <TextBlock Text="{Binding OptionalSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Button Content="Select the usual extras" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="SelectSuggested_Click"/>
          <ItemsControl ItemsSource="{Binding BloatItems}" ItemTemplate="{StaticResource DebloatTemplate}"/>
          <TextBlock Text="Other optional apps" FontWeight="SemiBold" Margin="0,10,0,4"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,6" Text="Mail, Copilot, Teams, and apps some people still want. Left unchecked."/>
          <ItemsControl ItemsSource="{Binding OtherItems}" ItemTemplate="{StaticResource DebloatTemplate}"/>
          <Expander Header="Advanced" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}" Margin="0,4,0,6"
                         Text="These change services. Each one says what you lose. They are not selected for you."/>
              <ItemsControl ItemsSource="{Binding AdvancedItems}" ItemTemplate="{StaticResource DebloatTemplate}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Security and boot (dangerous)" Foreground="{StaticResource Brush.Danger}" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,6"
                         Text="Closed unless you open it. Disabling Defender or Windows Update leaves the PC exposed. Disabling a boot service can stop Windows from starting. Nothing here is selected by default."/>
              <ItemsControl ItemsSource="{Binding DangerItems}" ItemTemplate="{StaticResource DebloatTemplate}"/>
            </StackPanel>
          </Expander>
          <Button Content="Apply selected" Style="{StaticResource PrimaryButton}" Margin="0,12,0,4" Click="ApplyDebloat_Click"/>
          <Button Content="Export profile" Style="{StaticResource SecondaryButton}" Margin="0,4" Click="Export_Click"/>
          <Button Content="Import profile" Style="{StaticResource SecondaryButton}" Margin="0,4" Click="Import_Click"/>
          <Button Content="Undo saved changes" Style="{StaticResource SecondaryButton}" Margin="0,4,0,12" Click="Undo_Click"/>
        </StackPanel>
      </ScrollViewer>

      <DockPanel Visibility="{Binding ShowLog, Converter={StaticResource BoolVis}}">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static core:AppPaths.ActionsFile}" Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <ListBox ItemsSource="{Binding LogLines}"/>
      </DockPanel>
    </Grid>

    <TextBlock Grid.Row="5" Text="{Binding FooterText}" Foreground="{StaticResource Brush.Muted}" FontSize="11" Margin="12,6,12,8"/>

    <Border Grid.RowSpan="6" Background="#E6111318" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
      <Border Background="#1C1F27" CornerRadius="12" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
        <StackPanel>
          <TextBlock Text="Working" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
        </StackPanel>
      </Border>
