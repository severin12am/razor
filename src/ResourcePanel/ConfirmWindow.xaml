<Window x:Class="ResourcePanel.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="380"
        ResizeMode="NoResize" WindowStyle="None"
        Background="#1C1F27" Foreground="#E8EAF0"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False" Topmost="True">
  <Border BorderBrush="#2C313C" BorderThickness="1" Padding="16">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#C5CAD3"/>
      <ScrollViewer MaxHeight="180" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="BulletText" TextWrapping="Wrap" Foreground="#9AA3B2"/>
      </ScrollViewer>
      <TextBlock x:Name="PhraseLabel" TextWrapping="Wrap" Margin="0,10,0,4" Visibility="Collapsed"/>
      <TextBox x:Name="PhraseBox" Visibility="Collapsed" Padding="8,5" Background="#14161C" Foreground="#E8EAF0" BorderBrush="#2C313C" TextChanged="Phrase_Changed"/>
      <UniformGrid Columns="2" Margin="0,14,0,0">
        <Button x:Name="NoButton" Content="Cancel" Margin="0,0,6,0" Height="34" Click="No_Click" Background="#2A2F3A" Foreground="#E8EAF0" BorderThickness="0"/>
        <Button x:Name="YesButton" Content="OK" Margin="6,0,0,0" Height="34" Click="Yes_Click" Background="#6FDBA2" Foreground="#102117" BorderThickness="0" FontWeight="SemiBold"/>
      </UniformGrid>
    </StackPanel>
  </Border>
</Window>
